# Backend (copy to backend/.env or export in shell / Render)
DATABASE_URL=sqlite:///./app.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAX_UPLOAD_BYTES=10485760
# Comma-separated browser origins allowed to call the API (no *)
CORS_ORIGINS=http://localhost:5173
# Local only — leave unset/false on Render so submission demos start empty
SEED_DEMO_DATA=true

# Frontend (copy to frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
