# Backend (copy to backend/.env or export in shell / Render)
DATABASE_URL=sqlite:///./app.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAX_UPLOAD_BYTES=10485760
# Comma-separated browser origins allowed to call the API (no *)
CORS_ORIGINS=http://localhost:5173
# Local only — leave unset/false on Render so submission demos start empty
SEED_DEMO_DATA=true
# Shared demo key for writes + /extract. Empty = open locally.
# On Render set the same value reviewers paste in the UI / pass as X-API-Key.
# Example: API_KEY=demo-reviewer-key
API_KEY=
# In-process /extract rate limit (per client IP, per instance)
EXTRACT_RATE_LIMIT_ENABLED=true
EXTRACT_RATE_LIMIT_PER_MINUTE=15

# Frontend (copy to frontend/.env)
# Do NOT put API_KEY in VITE_* — it would be public in the static bundle.
VITE_API_BASE_URL=http://localhost:8000
